# Copy this file to .env and fill it in. .env is git-ignored; never commit a real key.
# Real environment variables override anything in .env.

# Claude API key (create one at https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Model to use (Claude Haiku 5.5 is the fast, low-cost Claude model)
ANTHROPIC_MODEL=claude-haiku-5-5

# No key? Use the clearly labelled mock instead (not a real language model)
# LLM_PROVIDER=mock

# Seconds to wait for the model before giving up
LLM_TIMEOUT=20
